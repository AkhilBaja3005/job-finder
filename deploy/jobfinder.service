[Unit]
Description=Job Finder FastAPI Backend Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/job-finder/backend
ExecStart=/home/ubuntu/job-finder/backend/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PORT=8000
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
