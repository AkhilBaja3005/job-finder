{
  "manifest_version": 3,
  "name": "Job Finder ATS Tailor",
  "version": "3.6.0",
  "description": "ATS match scoring, resume tailoring, cover letters and outreach on LinkedIn, Indeed, Workday, Greenhouse, Lever and career sites.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://www.job-finder.space/*",
    "https://job-finder.space/*",
    "https://abaja-job-finder.hf.space/*",
    "https://www.gov.uk/*",
    "https://assets.publishing.service.gov.uk/*"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://www.job-finder.space/*",
      "https://job-finder.space/*",
      "https://abaja-job-finder.hf.space/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
