# ==============================================================================
# JOB FINDER AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your desired settings.
# Job Finder runs 100% locally with offline fallbacks (SQLite/CSV) - cloud
# connections (Supabase, Hugging Face, Cloudflare, Brevo) are STRICTLY OPTIONAL.
# Only Gemini LLM API keys are required for agent reasoning & tailoring.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE LLM CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Job Finder uses gemini-3.5-flash-lite by default for ultra-low latency & free quota.
# You can provide individual indexed keys (GEMINI_API_KEY, GEMINI_API_KEY_2, ...)
# or a single comma-separated list for automatic round-robin & 429 quota failover:
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_2=your_second_gemini_api_key_here
# GEMINI_API_KEY_3=your_third_gemini_api_key_here
# GEMINI_API_KEYS="key1,key2,key3"

# Optional Alternative LLM Providers:
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GROQ_API_KEY=your_groq_api_key
# NVIDIA_API_KEY=
# NVIDIA_DISABLED=1

# ------------------------------------------------------------------------------
# 2. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Optional Google OAuth (for web dashboard login; not needed for CLI / scanner):
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Set to receive email summaries when jobs fail verification or need user review.
# Supports standard Gmail SMTP, Brevo, or Resend:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional Brevo / Resend REST API keys (if you prefer HTTP email APIs over SMTP):
# BREVO_API_KEY=
# RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 4. SCRAPER & BROWSER AUTOMATION (LOCAL)
# ------------------------------------------------------------------------------
# Maximum concurrent Chromium instances during multi-platform search (default: 5)
SCRAPER_CONCURRENCY=5

# Browser-use automation options (headless: false opens visible browser, guardrails: 0 pauses on review screen):
BROWSER_USE_HEADLESS=false
JOB_FINDER_DISABLE_GUARDRAILS=0
BROWSER_USE_TIMEOUT=300

# Optional Reed.co.uk API Key (Free developer key from reed.co.uk/developers):
# REED_API_KEY=

# ------------------------------------------------------------------------------
# 5. CLOUD STORAGE & SYNC (OPTIONAL - OFFLINE CSV/SQLITE USED BY DEFAULT)
# ------------------------------------------------------------------------------
# If Supabase is omitted, Job Finder logs applications to applications_tracker/tracker.csv
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key

# If Hugging Face is omitted, tailored resumes are stored locally in output/
# HF_TOKEN=hf_your_huggingface_token

# Optional Cloudflare bindings:
# CLOUDFLARE_DISABLED=1
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional Ngrok tunnel (for public webhooks):
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
